// RestaurantMenu data model — see PRODUCT.md (domain) + I18N.md (translations).
// Invariants (AGENTS.md 10–12): shared Product catalog; venues are data;
// Product = venue-independent identity, MenuItem = venue/menu-specific facts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection for the app runtime (serverless)
  directUrl = env("DIRECT_URL") //  unpooled connection for migrations (OPS.md)
}

enum ProductKind {
  FOOD
  DRINK
}

// Single admin (the owner) — ADMIN_PLAN.md §3. The password is bcrypt-hashed and
// seeded via `prisma/auth.seed.ts` (`npm run seed:admin`); login verifies with
// bcrypt. Not committed anywhere in plaintext.
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique @default("admin")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Business {
  id            String     @id @default(cuid())
  name          String
  logo          String? // brand mark URL (admin-uploaded; falls back to BRAND.mark)
  footerExtra   String? // optional extra footer line (contact/address); shown below the legal notice
  currency      String     @default("TRY")
  defaultLocale String     @default("tr")
  locales       String[]   @default(["tr", "en", "ru"])
  venues        Venue[]
  categories    Category[]
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Venue {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug       String   @unique // drives /[venueSlug]; venue identity is data, not code
  name       String
  wordmark   String? // per-venue logo/wordmark path (data-driven; falls back to the Mono mark)
  sortOrder  Int      @default(0)
  menu       Menu?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// One menu per venue. Categories/items are attached per venue so ordering and
// visibility can differ between venues (evidenced: Terrace vs Garden).
model Menu {
  id         String         @id @default(cuid())
  venueId    String         @unique
  venue      Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  categories MenuCategory[]
  items      MenuItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// Shared taxonomy (Starters, Salads, ...). Hierarchy-capable (live SaaS parentId).
model Category {
  id           String                @id @default(cuid())
  businessId   String
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug         String
  // Optional grid column count for this category's photo cards (legacy per-category
  // layout: desserts/breakfast = 2, most food = 3). Null → the kind default.
  columns      Int?
  parentId     String?
  parent       Category?             @relation("CategoryChildren", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryChildren")
  translations CategoryTranslation[]
  menuLinks    MenuCategory[]
  items        MenuItem[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  // Soft-delete (admin data safety): non-null = trashed; filtered out of public
  // reads and recoverable (ADMIN_PLAN.md §6d).
  deletedAt    DateTime?

  @@unique([businessId, slug])
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     String
  name       String

  @@unique([categoryId, locale])
}

// Venue-independent identity. No price/visibility/order here (AGENTS.md 12).
model Product {
  id           String               @id @default(cuid())
  businessId   String
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug         String
  kind         ProductKind          @default(FOOD)
  image        String?
  color        String? // drink colour chip (legacy)
  tag          String? // drink family/tag (legacy)
  dlc          Boolean              @default(false) // wine: has a valid label (legacy "DLC" badge)
  translations ProductTranslation[]
  menuItems    MenuItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  // Soft-delete (admin data safety): non-null = trashed; filtered out of public
  // reads and recoverable (ADMIN_PLAN.md §6d).
  deletedAt    DateTime?

  @@unique([businessId, slug])
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  subtitle    String?
  description String?

  @@unique([productId, locale])
}

// Per-venue category placement: which categories show, in what order.
model MenuCategory {
  id         String   @id @default(cuid())
  menuId     String
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  visible    Boolean  @default(true) // e.g. Breakfast hidden on Terrace

  @@unique([menuId, categoryId])
}

// The Product↔Menu join. Venue/menu-specific: price, availability, order, category.
model MenuItem {
  id         String          @id @default(cuid())
  menuId     String
  menu       Menu            @relation(fields: [menuId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category        @relation(fields: [categoryId], references: [id])
  // Single price for simple items. For multi-measure items (spirits by cl,
  // wines by glass/bottle — legacy Hard Drinks) leave null and use `prices`.
  price      Decimal?        @db.Decimal(10, 2) // nullable: unknown prices flagged, never invented
  prices     MenuItemPrice[]
  available  Boolean         @default(true)
  featured   Boolean         @default(false) // spans full width in its category (legacy featured breakfast)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([menuId, productId])
}

// Optional labelled price measures for a menu item (e.g. "4 CL", "8 CL",
// "Kadeh", "Şişe"). Reproduces the legacy multi-column drink pricing without a
// wall of nullable columns.
model MenuItemPrice {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  label      String
  amount     Decimal  @db.Decimal(10, 2)
  sortOrder  Int      @default(0)

  @@unique([menuItemId, label])
}

// Admin audit trail (SECURITY.md §4b): one row per content mutation. Single-owner
// admin, so "who" is implicit — the value is what changed and when.
model AuditLog {
  id        String   @id @default(cuid())
  action    String // create | update | delete | restore | import | settings
  entity    String // category | product | brand | wordmark | backup
  detail    String? // human label (e.g. the item name / a short summary)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
