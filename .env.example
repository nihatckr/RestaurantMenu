# Copy to .env and fill in. Never commit real secrets (SECURITY.md §3).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# For serverless/pooled deploys, also set an unpooled DIRECT_URL for migrations (OPS.md):
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Admin auth (single owner — ADMIN_PLAN.md §3). The password is bcrypt-hashed in code
# and stored in the DB by `npm run seed:admin` (prisma/auth.seed.ts). Set the plaintext
# here, run the seed once, then the plaintext is only used to (re)generate the hash.
# Local dev defaults to "1234" if unset.
ADMIN_PASSWORD=change-me-to-a-strong-password
# ADMIN_USERNAME=admin   # optional; defaults to "admin"
# Random secret (>=32 chars) for the encrypted session cookie:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SESSION_SECRET=replace-with-a-random-48-hex-char-secret
# Dev-only: allow the session cookie over http://localhost with `next start`
# (production is HTTPS — never set this there).
# AUTH_ALLOW_HTTP=1

# Image uploads → Vercel Blob (DECISIONS B.12). Create a Blob store in the Vercel
# dashboard and copy its read-write token here. When UNSET (local dev/e2e),
# uploads fall back to /public/uploads so the flow works without a token.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
